-- ===== master combat heartbeat =====
local HitClock, NapeClock, TPClock, LastDodge = 0, 0, 0, 0
local PausedUntil = 0

keep(RunService.Heartbeat:Connect(function()
    if not Alive then return end
    pcall(function()
        -- rate limiter first
        while #KillTimes > 0 and KillTimes[1] < os.clock() - 60 do table.remove(KillTimes, 1) end
        if os.clock() < PausedUntil then return end
        if State["Ban.Humanize"] and #KillTimes > State["Ban.KillRateCap"] then
            PausedUntil = os.clock() + State["Ban.PauseTime"]
            Notify("ANTI-BAN", string.format("kill rate %d/min hit cap — pausing %ds",
                #KillTimes, State["Ban.PauseTime"]), 5)
            return
        end

        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local targets = collectTitans(State["Combat.Radius"])
        if #targets == 0 then return end

        -- auto dodge
        if State["Move.AutoDodge"] and os.clock() - LastDodge > 1 then
            for _, t in ipairs(targets) do
                if t.Dist < State["Move.DodgeRadius"] then
                    local vel = t.Root.AssemblyLinearVelocity
                    if vel.Magnitude > 10
                    and vel.Unit:Dot((hrp.Position - t.Root.Position).Unit) > 0.5 then
                        hrp.CFrame += hrp.CFrame.RightVector * 18
                        LastDodge = os.clock()
                        break
                    end
                end
            end
        end

        -- tp behind titan
        if State["Combat.TPBehind"] and os.clock() - TPClock > State["Combat.TPDelay"] then
            local target = targets[1]
            local root = target.Model:FindFirstChild("HumanoidRootPart")
            local nape = getNape(target.Model)
            if root and nape and nape:IsA("BasePart") then
                local stand = nape.Position + (-root.CFrame.LookVector) * State["Combat.BackDist"]
                if (stand - nape.Position).Magnitude < 0.5 then
                    stand += Vector3.new(0, 1, 0) -- NaN guard for lookAt
                end
                hrp.CFrame = CFrame.lookAt(stand, nape.Position)
                TPClock = os.clock()
            end
        end

        -- auto nape positioning
        if State["Combat.AutoNape"] and os.clock() - NapeClock > State["Combat.NapeDelay"] then
            local target = targets[1]
            local root = target.Model:FindFirstChild("HumanoidRootPart")
            local nape = getNape(target.Model)
            if nape and nape:IsA("BasePart") then
                local method = State["Combat.NapeMethod"]
                if method == "Teleport" and root then
                    local stand = nape.Position + (-root.CFrame.LookVector) * 2.5
                    if (stand - nape.Position).Magnitude < 0.5 then stand += Vector3.new(0, 1, 0) end
                    hrp.CFrame = CFrame.lookAt(stand, nape.Position)
                elseif method == "Orbit Swing" then
                    local ang = os.clock() * 4
                    hrp.CFrame = nape.CFrame * CFrame.new(0, 1.5, -2.5)
                        * CFrame.new(math.cos(ang) * 4, 0, math.sin(ang) * 4)
                else -- Wiggle
                    local jx, jy = (math.random() - 0.5) * 3, (math.random() - 0.5) * 2
                    hrp.CFrame = nape.CFrame * CFrame.new(0, 1.5, -2.5)
                        * CFrame.new(jx, jy, math.random() * 2)
                end
                NapeClock = os.clock()
            end
        end

        -- the fire itself
        local wantsFire = State["Combat.KillAura"] or State["Combat.AutoNape"]
            or State["Combat.SilentAim"]
        if wantsFire then
            local cd = State["Combat.Cooldown"]
            if State["Ban.Humanize"] then
                cd = cd * (0.85 + math.random() * 0.3) -- ±15% human rhythm
            end
            if os.clock() - HitClock > cd then
                local nape = getNape(targets[1].Model)
                if nape then
                    fireDamage(nape, targets[1].Model)
                    HitClock = os.clock()
                end
            end
        end
    end)
end))

