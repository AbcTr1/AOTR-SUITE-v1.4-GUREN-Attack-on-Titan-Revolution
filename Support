        v = math.clamp(v, min, max)
        v = math.floor(v * 10 ^ decimals + 0.5) / 10 ^ decimals
        State[path] = v
        local alpha = (v - min) / (max - min)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        valueText.Text = string.format("%." .. decimals .. "f", v)
        if fire and callback then callback(v) end
    end
    Setters[path] = function(v) Set(v, true) end

    local function setFromX(x)
        local alpha = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        Set(min + (max - min) * alpha, true)
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            DraggingSlider = setFromX
            setFromX(input.Position.X)
        end
    end)
    Set(default, false)
end

