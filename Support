-- ===== ESP: tracked, categorized, properly culled =====
local ESPEntries = {} -- instance -> { Highlight, Cat }

local function addESP(inst, color, cat)
    if ESPEntries[inst] then return end
    if not inst:IsA("BasePart") and not inst:IsA("Model") then return end
    local h = Instance.new("Highlight")
    h.FillColor = color
    h.FillTransparency = 0.7
    h.OutlineColor = color
    h.OutlineTransparency = 0.1
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = inst
    ESPEntries[inst] = { Highlight = h, Cat = cat }
end

local function removeESP(inst)
    local e = ESPEntries[inst]
    if not e then return end
    pcall(function() e.Highlight:Destroy() end)
    ESPEntries[inst] = nil
end

task.spawn(function()
    while Alive do
        pcall(function()
            local maxD = State["Vis.ESPMaxDist"]
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            if State["Vis.TitanESP"] then
                for _, t in ipairs(collectTitans(maxD)) do
                    addESP(t.Model, isAberrant(t.Model) and Theme.Coral or Theme.Accent, "titan")
                end
            end
            if State["Vis.PlayerESP"] then
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LP and pl.Character
                    and pl.Character:FindFirstChild("HumanoidRootPart")
                    and (pl.Character.HumanoidRootPart.Position - hrp.Position).Magnitude <= maxD then
                        addESP(pl.Character, Theme.Blue, "player")
                    end
                end
            end
            if State["Vis.MissionESP"] then
                for _, name in ipairs(MISSION_HINTS) do
                    local f = Workspace:FindFirstChild(name, true)
                    if f then
                        local added = 0
                        for _, c in ipairs(f:GetChildren()) do
                            if added >= 20 then break end -- bounded, no workspace floods
                            if c:IsA("BasePart")
                            and (c.Position - hrp.Position).Magnitude <= maxD then
                                addESP(c, Color3.fromRGB(230, 190, 80), "mission")
                                added += 1
                            end
                        end
                    end
                end
            end

            -- cull: gone, category off, or out of range
            local catOn = {
                titan = State["Vis.TitanESP"],
                player = State["Vis.PlayerESP"],
                mission = State["Vis.MissionESP"],
            }
            for inst, e in pairs(ESPEntries) do
                if not inst.Parent or not catOn[e.Cat] then
                    removeESP(inst)
                else
                    local root = inst:IsA("Model")
                        and (inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChild("Head"))
                        or inst
                    if root and root:IsA("BasePart") then
                        local d = (root.Position - hrp.Position).Magnitude
                        e.Highlight.Enabled = d <= maxD
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end)

