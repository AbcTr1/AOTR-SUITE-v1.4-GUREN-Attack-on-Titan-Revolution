        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if State["Move.Fly"] then
            if not FlyVelocity or FlyVelocity.Parent ~= hrp then
                flyCleanup()
                local attach = Instance.new("Attachment")
                attach.Name = "AOTR_FlyAtt"
                attach.Parent = hrp
                FlyVelocity = Instance.new("LinearVelocity")
                FlyVelocity.Attachment0 = attach
                FlyVelocity.MaxForce = 1e6
                FlyVelocity.VectorVelocity = Vector3.zero
                FlyVelocity.Parent = hrp
            end
            local cam = Workspace.CurrentCamera
            local dir = Vector3.zero
            local cf = cam.CFrame
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cf.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cf.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.yAxis end
            FlyVelocity.VectorVelocity = dir.Magnitude > 0
                and dir.Unit * State["Move.FlySpeed"] or Vector3.zero
        elseif FlyVelocity then
            flyCleanup()
        end
    end)
end)

-- ===== ANTI-KICK: namecall hook blocks Kick on LocalPlayer =====
-- most roblox games execute a kick by having the server call :Kick() on you
-- through the client; the hook swallows that call before it lands.
task.spawn(function()
    local hasHooks = pcall(function()
        assert(type(hookmetamethod) == "function", "no hookmetamethod")
        assert(type(getnamecallmethod) == "function", "no getnamecallmethod")
        assert(type(newcclosure) == "function", "no newcclosure")
    end)
    if not hasHooks then
        Notify("ANTI-KICK", "executor lacks hook support — hook inactive", 5)
        return
    end
    local OldNamecall
    local ok = pcall(function()
        OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if State["Ban.AntiKick"] and method == "Kick" and self == Players.LocalPlayer then
                Stats.KicksBlocked += 1
                Notify("ANTI-KICK", "kick blocked · total " .. Stats.KicksBlocked)
                return nil
            end
            return OldNamecall(self, ...)
        end))
    end)
    if ok then
        Notify("ANTI-KICK", "hook armed · watching LocalPlayer:Kick")
    else
        Notify("ANTI-KICK", "hook failed to mount on this executor", 5)
    end
end)

