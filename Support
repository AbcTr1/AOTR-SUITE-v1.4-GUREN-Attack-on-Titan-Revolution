local CONFIG_DIR, CONFIG_PATH = "AOTR", "AOTR/config.json"
local function SaveConfig()
    if not (writefile and makefolder and isfolder) then
        Notify("Config", "this executor has no file APIs") return
    end
    local snap = {}
    for path, v in pairs(State) do
        if typeof(v) == "EnumItem" then v = v.Name end
        snap[path] = v
    end
    if not isfolder(CONFIG_DIR) then pcall(makefolder, CONFIG_DIR) end
    pcall(writefile, CONFIG_PATH, HttpService:JSONEncode(snap))
    Notify("Config", "saved")
end
local function LoadConfig()
    if not (readfile and isfile) then
        Notify("Config", "this executor has no file APIs") return
    end
    if not isfile(CONFIG_PATH) then Notify("Config", "no saved config") return end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_PATH)) end)
    if not ok or type(decoded) ~= "table" then Notify("Config", "config corrupt") return end
    local applied = 0
    for path, v in pairs(decoded) do
        local setter = Setters[path]
        if setter then
            if path:find("Bind", 1, true) and type(v) == "string" then
                v = Enum.KeyCode[v] or v
            end
            setter(v)
            applied += 1
        end
    end
    Notify("Config", "loaded " .. applied .. " settings")
end
