-- ===== ESP =====
local HighlightMap = {}

local function addESP(model, fillCol)
    if HighlightMap[model] then return end
    local h = Instance.new("Highlight")
    h.FillColor = fillCol
    h.FillTransparency = 0.7
    h.OutlineColor = fillCol
    h.OutlineTransparency = 0.1
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = model
    HighlightMap[model] = { Highlight = h }
end

local function removeESP(model)
    local entry = HighlightMap[model]
    if not entry then return end
    if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
    HighlightMap[model] = nil
end

task.spawn(function()
    while Alive do
        pcall(function()
            local maxD = State["Vis.ESPMaxDist"]
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            if State["Vis.TitanESP"] then
                for _, t in ipairs(collectTitans(1e9)) do
                    if t.Dist <= maxD then
                        addESP(t.Model, isAberrant(t.Model) and Theme.Coral or Theme.Accent)
                    end
                end
            end
            if State["Vis.PlayerESP"] then
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LP and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                    and (pl.Character.HumanoidRootPart.Position - hrp.Position).Magnitude <= maxD then
                        addESP(pl.Character, Color3.fromRGB(90, 180, 220))
                    end
                end
            end
            for model in pairs(HighlightMap) do
                if not model.Parent then
                    removeESP(model)
                else
                    local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
                    if not root or (root.Position - hrp.Position).Magnitude > maxD then
                        if HighlightMap[model].Highlight then HighlightMap[model].Highlight.Enabled = false end
                    elseif HighlightMap[model].Highlight then
                        HighlightMap[model].Highlight.Enabled = true
                    end
                end
            end
        end)
        task.wait(0.5)
    end
end)

