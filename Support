local function freezeStats(hints)
    local char = LP.Character
    if not char then return end
    local touched = false
    for _, c in ipairs(char:GetDescendants()) do
        if c:IsA("NumberValue") or c:IsA("IntValue") then
            for _, h in ipairs(hints) do
                if c.Name:lower():find(h:lower()) then
                    c.Value = math.max(c.Value, 100)
                    touched = true
                end
            end
        end
    end
    local ls = LP:FindFirstChild("Leaderstats")
    if ls then
        for _, s in ipairs(ls:GetChildren()) do
            if s:IsA("NumberValue") then
                for _, h in ipairs(hints) do
                    if s.Name:lower():find(h:lower()) then
                        s.Value = math.max(s.Value, 100)
                        touched = true
                    end
                end
            end
        end
    end
    return touched
end

