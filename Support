            local active = State["Combat.SilentAim"] or State["Combat.KillAura"]
                or State["Combat.AutoNape"]
            if not active then
                restoreHitboxes()
                return
            end
            local mult = State["Combat.Hitbox"]
            for _, t in ipairs(collectTitans(State["Combat.Radius"])) do
                local nape = getNape(t.Model)
                if nape and nape:IsA("BasePart") and nape.Size.X < 40 then
                    if not OriginalSizes[nape] then OriginalSizes[nape] = nape.Size end
                    nape.Size = OriginalSizes[nape] * mult
