local TITAN_FOLDER_HINTS = { "Titans", "Titan", "Enemies", "Mobs", "NPCs" }
local NAPE_PART_HINTS    = { "Nape", "Neck", "WeakPoint", "Weakpoint", "Hitbox" }
local MISSION_HINTS      = { "Mission", "Objective", "Quest", "Contract" }
local STAT_HINTS_GAS     = { "Gas", "Fuel", "Odmgas", "GasAmount" }
local STAT_HINTS_BLADE   = { "Dura", "Blade", "Blades", "Durability" }
local MAX_TITANS_PER_TICK = 50   -- corrupted-workspace guard: never iterate more

local function findTitanContainer()
    for _, name in ipairs(TITAN_FOLDER_HINTS) do
        local ok, f = pcall(function() return Workspace:FindFirstChild(name, true) end)
        if ok and f then return f end
    end
    return Workspace
end

local function isTitan(model)
    if not model:IsA("Model") then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local ok, size = pcall(model.GetExtentsSize, model)
    if not ok then return false end
    return size.Y > 12 -- titans tower; players ride a normal-scale Humanoid
end

local function isBoss(model)
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.MaxHealth >= 1000
end

local function isAberrant(model)
    local name = model.Name:lower()
    return name:find("aberrant") ~= nil or name:find("abnormal") ~= nil
end

local function getNape(model)
    for _, hint in ipairs(NAPE_PART_HINTS) do
        local p = model:FindFirstChild(hint, true)
        if p and p:IsA("BasePart") then return p end
    end
    return model:FindFirstChild("Head", true) or model:FindFirstChild("HumanoidRootPart", true)
end

local function collectTitans(maxDist)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local out, scanned = {}, 0
    for _, m in ipairs(findTitanContainer():GetChildren()) do
        scanned += 1
        if scanned > MAX_TITANS_PER_TICK then break end
        if isTitan(m) then
            local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
            if root then
                local d = (root.Position - hrp.Position).Magnitude
                if d <= (maxDist or State["Combat.Radius"]) then
                    table.insert(out, { Model = m, Root = root, Dist = d })
                end
            end
        end
    end
    local prio = State["Farm.Priority"]
    if State["Farm.AutoRaid"] then
        table.sort(out, function(a, b)
            local ab, bb = isBoss(a.Model) and 0 or 1, isBoss(b.Model) and 0 or 1
            if ab ~= bb then return ab < bb end
            return a.Dist < b.Dist
        end)
    elseif prio == "Lowest HP" then
        table.sort(out, function(a, b)
            local ha = a.Model:FindFirstChildOfClass("Humanoid").Health
            local hb = b.Model:FindFirstChildOfClass("Humanoid").Health
            return ha < hb
        end)
    elseif prio == "Aberrant First" then
        table.sort(out, function(a, b)
            local aa, ba = isAberrant(a.Model) and 0 or 1, isAberrant(b.Model) and 0 or 1
            if aa ~= ba then return aa < ba end
            return a.Dist < b.Dist
        end)
    else
        table.sort(out, function(a, b) return a.Dist < b.Dist end)
    end
    return out
end

------------------------------------------------------------------ remote dump
local function dumpRemotes()
    local found, n = {}, 0
    local function walk(parent, path)
        for _, c in ipairs(parent:GetChildren()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                n += 1
                table.insert(found, string.format("%s  (%s)  ->  %s",
                    c.Name, c.ClassName, path .. "." .. c.Name))
            end
            if #c:GetChildren() > 0 then
                walk(c, path .. "." .. c.Name)
            end
        end
    end
    pcall(walk, Replicated, "ReplicatedStorage")
    pcall(walk, Workspace, "Workspace")
    table.sort(found)
    print("=== AOTR remote dump (" .. n .. " found) ===")
    for _, line in ipairs(found) do print(line) end
    print("=== fill REMOTES block in the script, look for damage/mission/respawn ===")
    return n
end

local function fireDamage(hitPart, model)
    if REMOTES.Damage == "" then return false end
    local ok = pcall(function()
        Replicated:FindFirstChild(REMOTES.Damage, true)
            :FireServer(unpack(DAMAGE_ARGS(hitPart, model, State["Combat.DamageMult"])))
    end)
    return ok
end

