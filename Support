local function statNames(model, hints)
    local names = {}
    for _, c in ipairs(model:GetDescendants()) do
        if c:IsA("NumberValue") or c:IsA("IntValue") then
            for _, h in ipairs(hints) do
                if c.Name:lower():find(h:lower()) then table.insert(names, c) end
            end
        end
    end
    return names
end

