-- ===== master combat heartbeat =====
local HitClock, NapeClock, TPClock, LastDodge = 0, 0, 0, 0
local PausedUntil = 0

RunService.Heartbeat:Connect(function()
    if not Alive then return end
    local ok = pcall(function()
        -- rate limiter: rolling window prune, cap check, farm pause
        while #KillTimes > 0 and KillTimes[1] < os.clock() - 60 do table.remove(KillTimes, 1) end
        if os.clock() < PausedUntil then return end
        if State["Ban.Humanize"] and #KillTimes > State["Ban.KillRateCap"] then
            PausedUntil = os.clock() + State["Ban.PauseTime"]
            Notify("ANTI-BAN", string.format("kill rate %d/min hit the cap — paused %ds",
                #KillTimes, State["Ban.PauseTime"]), 5)
            return
        end

        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end

        local targets = collectTitans(State["Combat.Radius"])
        if #targets == 0 then return end

        -- auto dodge: titan closing fast -> sidestep
        if State["Move.AutoDodge"] and os.clock() - LastDodge > 1 then
            for _, t in ipairs(targets) do
                if t.Dist < State["Move.DodgeRadius"] then
                    local vel = t.Root.AssemblyLinearVelocity
                    local toMe = (hrp.Position - t.Root.Position).Unit
                    if vel.Magnitude > 10 and vel.Unit:Dot(toMe) > 0.5 then
                        hrp.CFrame += hrp.CFrame.RightVector * 18
                        LastDodge = os.clock()
                        break
                    end
                end
            end
        end

        -- tp behind titan: blink to the back of the neck, facing the nape
        if State["Combat.TPBehind"] and os.clock() - TPClock > State["Combat.TPDelay"] then
            local target = targets[1]
            local root = target.Model:FindFirstChild("HumanoidRootPart")
            local nape = getNape(target.Model)
            if root and nape and nape:IsA("BasePart") then
                local backDir = -root.CFrame.LookVector
                local stand = nape.Position + backDir * State["Combat.BackDist"]
                hrp.CFrame = CFrame.lookAt(stand, nape.Position)
                TPClock = os.clock()
            end
        end

        -- auto nape: positioning methods
        if State["Combat.AutoNape"] and os.clock() - NapeClock > State["Combat.NapeDelay"] then
            local target = targets[1]
            local root = target.Model:FindFirstChild("HumanoidRootPart")
            local nape = getNape(target.Model)
            if nape and nape:IsA("BasePart") and root then
                local method = State["Combat.NapeMethod"]
                if method == "Teleport" then
                    local backDir = -root.CFrame.LookVector
                    local stand = nape.Position + backDir * 2.5
                    hrp.CFrame = CFrame.lookAt(stand, nape.Position)
                elseif method == "Orbit Swing" then
                    local ang = os.clock() * 4
                    local off = CFrame.new(math.cos(ang) * 4, 0, math.sin(ang) * 4)
                    hrp.CFrame = nape.CFrame * CFrame.new(0, 1.5, -2.5) * off
                else -- Wiggle
                    local jx, jy = (math.random() - 0.5) * 3, (math.random() - 0.5) * 2
                    hrp.CFrame = nape.CFrame * CFrame.new(0, 1.5, -2.5) * CFrame.new(jx, jy, math.random() * 2)
                end
                hrp.CFrame = CFrame.lookAt(hrp.Position, nape.Position)
                NapeClock = os.clock()
            end
        end

        -- kill aura / silent aim / auto nape fire, humanized jitter on the cooldown
        local wantsFire = State["Combat.KillAura"]
            or (State["Combat.SilentAim"] and #targets > 0)
            or State["Combat.AutoNape"]
        if wantsFire then
            local cd = State["Combat.Cooldown"]
            if State["Ban.Humanize"] then
                cd = cd * (0.85 + math.random() * 0.3) -- ±15%: reads like a human swing rhythm
            end
            if os.clock() - HitClock > cd then
                local target = targets[1]
                local nape = getNape(target.Model)
                if nape then
                    fireDamage(nape, target.Model)
                    HitClock = os.clock()
                end
            end
        end
    end)
    if not ok then
        HitClock = os.clock() -- one bad tick backs the fire off, loop lives
    end
end)

