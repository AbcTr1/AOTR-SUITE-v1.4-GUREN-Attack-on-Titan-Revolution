------------------------------------------------------------------ unload
Unload = function()
    if not Alive then return end
    Alive = false
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    if DeathConn then pcall(function() DeathConn:Disconnect() end) end
    for _, conn in pairs(WatchConns) do pcall(function() conn:Disconnect() end) end
    flyCleanup()
    restoreHitboxes()
    for inst in pairs(ESPEntries) do removeESP(inst) end
    if FogOriginals then
        pcall(function()
            Lighting.FogEnd = FogOriginals.FogEnd
            Lighting.FogStart = FogOriginals.FogStart
            if FogOriginals.Atm and FogOriginals.AtmDensity then
                FogOriginals.Atm.Density = FogOriginals.AtmDensity
            end
        end)
    end
    pcall(function() Gui:Destroy() end)
end

