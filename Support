        Main.Visible = not Main.Visible
    elseif input.KeyCode == Enum.KeyCode.End then
        Unload()
    elseif input.KeyCode == State["Bind.Fly"] then
        Setters["Move.Fly"](not State["Move.Fly"])
    end
end))

