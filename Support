function Unload()
    if not Alive then return end
    Alive = false
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    flyCleanup()
    for model in pairs(HighlightMap) do removeESP(model) end
    for part, orig in pairs(OriginalSizes) do
        pcall(function() if part.Parent then part.Size = orig end end)
    end
    if FogOriginals then
        pcall(function()
            Lighting.FogEnd = FogOriginals.FogEnd
            Lighting.FogStart = FogOriginals.FogStart
            if FogOriginals.Atmosphere and FogOriginals.AtmDensity then
                FogOriginals.Atmosphere.Density = FogOriginals.AtmDensity
            end
        end)
    end
    pcall(function() Gui:Destroy() end)
end

