local TITAN_FOLDER_HINTS = { "Titans", "Titan", "Enemies", "Mobs", "NPCs" }
local NAPE_PART_HINTS    = { "Nape", "Neck", "WeakPoint", "Weakpoint", "Hitbox" }
local MISSION_HINTS      = { "Mission", "Objective", "Quest", "Contract" }
local STAT_HINTS_GAS     = { "Gas", "Fuel" }
local STAT_HINTS_BLADE   = { "Dura", "Blade" }
local MAX_TITANS_PER_TICK = 50

local TitanContainer = nil -- cached; v1.4 re-searched the whole tree per frame
local function findTitanContainer()
    if TitanContainer and TitanContainer.Parent then return TitanContainer end
    for _, name in ipairs(TITAN_FOLDER_HINTS) do
        local ok, f = pcall(function() return Workspace:FindFirstChild(name, true) end)
        if ok and f and f.Parent then
            TitanContainer = f
            return f
        end
    end
    return Workspace -- fallback: full scan, model filter does the work
end

local function getHum(model)
    if not model or not model.Parent then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

local function isTitan(model)
    if not model:IsA("Model") then return false end
    local hum = getHum(model)
    if not hum or hum.Health <= 0 then return false end
    local ok, size = pcall(model.GetExtentsSize, model)
    if not ok then return false end
    return size.Y > 12
end

local function isBoss(model)
    local hum = getHum(model)
    return hum ~= nil and hum.MaxHealth >= 1000
end

local function isAberrant(model)
    local n = model.Name:lower()
    return n:find("aberrant") ~= nil or n:find("abnormal") ~= nil
end

local function getNape(model)
    for _, hint in ipairs(NAPE_PART_HINTS) do
        local p = model:FindFirstChild(hint, true)
        if p and p:IsA("BasePart") then return p end
    end
    return model:FindFirstChild("Head", true) or model:FindFirstChild("HumanoidRootPart", true)
end

local function collectTitans(maxDist)
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end
    local out, scanned = {}, 0
    for _, m in ipairs(findTitanContainer():GetChildren()) do
        scanned += 1
        if scanned > MAX_TITANS_PER_TICK then break end
        if isTitan(m) then
            local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
            if root then
                local d = (root.Position - hrp.Position).Magnitude
                if d <= (maxDist or State["Combat.Radius"]) then
                    table.insert(out, { Model = m, Root = root, Dist = d })
                end
            end
        end
    end
    local prio = State["Farm.Priority"]
    if State["Farm.AutoRaid"] then
        table.sort(out, function(a, b)
            local ab, bb = isBoss(a.Model) and 0 or 1, isBoss(b.Model) and 0 or 1
            if ab ~= bb then return ab < bb end
            return a.Dist < b.Dist
        end)
    elseif prio == "Lowest HP" then
        table.sort(out, function(a, b)
            local ha = getHum(a.Model); local hb = getHum(b.Model)
            return (ha and ha.Health or 1e9) < (hb and hb.Health or 1e9)
        end)
    elseif prio == "Aberrant First" then
        table.sort(out, function(a, b)
            local aa, ba = isAberrant(a.Model) and 0 or 1, isAberrant(b.Model) and 0 or 1
            if aa ~= ba then return aa < ba end
            return a.Dist < b.Dist
        end)
    else
        table.sort(out, function(a, b) return a.Dist < b.Dist end)
    end
    return out
end

------------------------------------------------------------------ remotes
local function dumpRemotes()
    local found, n = {}, 0
    local function walk(parent, path, depth)
        if depth > 4 then return end
        for _, c in ipairs(parent:GetChildren()) do
            if c:IsA("RemoteEvent") or c:IsA("RemoteFunction") then
                n += 1
                table.insert(found, string.format("%s (%s) -> %s", c.Name, c.ClassName, path))
            end
            if #c:GetChildren() > 0 then walk(c, path .. "." .. c.Name, depth + 1) end
        end
    end
    pcall(walk, Replicated, "ReplicatedStorage", 0)
    pcall(walk, Workspace, "Workspace", 0)
    table.sort(found)
    print("=== AOTR remote dump (" .. n .. ") ===")
    for _, line in ipairs(found) do print(line) end
    print("=== fill REMOTES block: damage / mission / respawn ===")
end

local function fireDamage(hitPart, model)
    if REMOTES.Damage == "" then return false end
    local remote = Replicated:FindFirstChild(REMOTES.Damage, true)
    if not remote then return false end
    local ok = pcall(remote.FireServer, remote,
        unpack(DAMAGE_ARGS(hitPart, model, State["Combat.DamageMult"])))
    return ok
end

